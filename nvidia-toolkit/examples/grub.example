# Example GRUB configuration for NVIDIA
# Location: /etc/default/grub
#
# After modifying, run:
# Debian/Ubuntu: sudo update-grub
# Arch: sudo grub-mkconfig -o /boot/grub/grub.cfg

# Default entry
GRUB_DEFAULT=0

# Timeout
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu

# Kernel parameters for NVIDIA
# NOTE: nvidia-drm.modeset=1 is REQUIRED for Wayland sessions
# and recommended for X11 (enables DRM kernel modesetting)
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash nvidia-drm.modeset=1"

# For ACPI issues (common on Parrot OS 7):
# GRUB_CMDLINE_LINUX_DEFAULT="quiet splash nvidia-drm.modeset=1 noapic"

# For severe ACPI problems (last resort, disables power management):
# GRUB_CMDLINE_LINUX_DEFAULT="quiet splash nvidia-drm.modeset=1 acpi=off"

# For debugging boot issues:
# GRUB_CMDLINE_LINUX_DEFAULT="nvidia-drm.modeset=1 nomodeset debug"

# Graphics card detection
GRUB_GFXMODE=auto

# Hidden menu (comment out to show menu)
# GRUB_TIMEOUT_STYLE=hidden

# Distribution specific
GRUB_DISTRIBUTOR=`lsb_release -i -s 2> /dev/null || echo Debian`

# Recovery mode
GRUB_DISABLE_RECOVERY="false"
