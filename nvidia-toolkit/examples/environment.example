# Example /etc/environment for NVIDIA Wayland support
# Location: /etc/environment
#
# These variables are required for NVIDIA GPUs on Wayland sessions.
# The nvidia-install.sh script sets these automatically when you
# choose "Wayland" or "Both" session types.
#
# After modifying, log out and back in for changes to take effect.

# Use NVIDIA GBM backend for Wayland buffer allocation
GBM_BACKEND=nvidia-drm

# Use NVIDIA for GLX rendering in Wayland
__GLX_VENDOR_LIBRARY_NAME=nvidia

# Uncomment if you have cursor issues on wlroots-based compositors (Sway, Hyprland)
# Not needed for KDE Plasma or GNOME
# WLR_NO_HARDWARE_CURSORS=1
