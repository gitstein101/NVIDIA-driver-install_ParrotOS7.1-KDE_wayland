# Example mkinitcpio.conf for Arch/BlackArch with NVIDIA
# Location: /etc/mkinitcpio.conf
#
# After modifying, run: sudo mkinitcpio -P

# MODULES
# Add NVIDIA modules for early KMS start
MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)

# BINARIES
# Optional: add additional binaries here
BINARIES=()

# FILES
# Optional: add additional files here
FILES=()

# HOOKS
# The running hook order
# NOTE: Add nvidia before kms hook, or remove kms entirely
HOOKS=(base udev autodetect modconf block filesystems keyboard fsck)

# COMPRESSION
# Use lz4 for faster boot (optional)
COMPRESSION="lz4"

# Notes:
# 1. If you have kms hook, either:
#    - Remove it, OR
#    - Ensure nvidia modules are loaded BEFORE kms
# 2. The nvidia_drm module provides KMS functionality
# 3. After editing, always run: sudo mkinitcpio -P
